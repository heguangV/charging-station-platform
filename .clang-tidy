Checks: >
  -*,
  bugprone-*,
  performance-*,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override,
  readability-identifier-naming
WarningsAsErrors: ''
HeaderFilterRegex: '^(apps|core|infrastructure|server|tests)/'
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
