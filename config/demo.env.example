NCS_ENV=demo
NCS_SERVER_HOST=127.0.0.1
NCS_SERVER_PORT=9443
NCS_DATABASE_PATH=runtime/demo/charge_platform.db
NCS_LOG_DIR=runtime/demo/logs
NCS_ALLOW_INSECURE_HTTP=false
NCS_TLS_CERT_PATH=runtime/certs/dev-cert.pem
NCS_TLS_KEY_PATH=runtime/certs/dev-key.pem
NCS_BILLING_TIME_MULTIPLIER=60
NCS_SIMULATED_SMS_ENABLED=true
NCS_DASHBOARD_SNAPSHOT_ENABLED=true
TENCENT_MAP_JS_KEY=
TENCENT_MAP_SERVER_KEY=
TENCENT_MAP_JS_ORIGIN=http://localhost/
