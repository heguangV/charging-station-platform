# Copy this file to .env for local development. Never commit the real .env.
APP_ENV=development
SERVER_LISTEN_ADDRESS=127.0.0.1
SERVER_PORT=8080
DEMO_OTP_ENABLED=false

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=charging_station
POSTGRES_USER=charging_station_app
POSTGRES_PASSWORD=replace_me

# Tencent Maps is the selected provider. Restrict the real key in its console.
TENCENT_MAP_KEY=replace_me

# Server secrets must remain on the server and must never be embedded in an APK.
TPNS_ACCESS_ID=replace_me
TPNS_ACCESS_KEY=replace_me
TPNS_SECRET_KEY=replace_me
