# Copy this file to .env for local development. Never commit the real .env.
APP_ENV=development
DEMO_OTP_ENABLED=false

# Tencent Maps is the selected provider. Keep the server key out of every client.
# The JS key is client-visible by nature, so restrict its allowed origins and quota.
TENCENT_MAP_JS_KEY=replace_me
TENCENT_MAP_SERVER_KEY=replace_me
# Must match an allowed JavaScript API origin during local WebView development.
TENCENT_MAP_JS_ORIGIN=http://localhost/
# Production Android builds should load a server-hosted map page instead of bundling a key.
TENCENT_MAP_PAGE_URL=
