# Copy this file to .env for local development. Never commit the real .env file.
NCS_ENV=development
NCS_SERVER_HOST=127.0.0.1
NCS_SERVER_PORT=8443
NCS_DATABASE_PATH=runtime/development/charge_platform.db
NCS_LOG_DIR=runtime/development/logs

# Development may use HTTP only on a controlled local/VM interface.
# Production must set this to false and provide both TLS paths.
NCS_ALLOW_INSECURE_HTTP=true
NCS_TLS_CERT_PATH=
NCS_TLS_KEY_PATH=
NCS_BILLING_TIME_MULTIPLIER=60
NCS_SIMULATED_SMS_ENABLED=true
NCS_DASHBOARD_SNAPSHOT_ENABLED=true

# Optional map credentials. Keep real values only in .env or a secret store.
NCS_TENCENT_MAP_WEB_KEY=
NCS_TENCENT_MAP_SERVICE_KEY=
