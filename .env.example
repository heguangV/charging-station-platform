# Copy this file to .env for local development. Never commit the real .env file.
NCS_ENV=development
NCS_SERVER_HOST=127.0.0.1
NCS_SERVER_PORT=8443
NCS_DATABASE_PATH=runtime/development/charge_platform.db
NCS_LOG_DIR=runtime/development/logs

# Safe default is HTTPS. Set true in both processes only for development on
# numeric loopback 127.0.0.1 or ::1; non-development/non-loopback is rejected.
NCS_ALLOW_INSECURE_HTTP=false
NCS_TLS_CERT_PATH=
NCS_TLS_KEY_PATH=
NCS_BILLING_TIME_MULTIPLIER=60
NCS_SIMULATED_SMS_ENABLED=true
NCS_DASHBOARD_SNAPSHOT_ENABLED=true

# Optional Tencent map credentials. JS Key is client-visible; Server Key is
# read only by ncs_server. Keep real values only in .env or a secret store.
TENCENT_MAP_JS_KEY=
TENCENT_MAP_SERVER_KEY=
TENCENT_MAP_JS_ORIGIN=http://localhost/
