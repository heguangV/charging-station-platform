# Copy this file to .env for local development. Never commit the real .env file.
NCS_ENVIRONMENT=development
NCS_LISTEN_ADDRESS=127.0.0.1
NCS_PORT=8443
# PostgreSQL is the only production database backend. Keep credentials only in
# the real .env or process environment; never commit them.
NCS_DATABASE_DRIVER=postgresql
NCS_DATABASE_HOST=127.0.0.1
NCS_DATABASE_PORT=5432
NCS_DATABASE_NAME=ncs
NCS_DATABASE_USER=ncs
NCS_DATABASE_PASSWORD=
NCS_DATABASE_SSLMODE=prefer
NCS_DATABASE_SSL_ROOT_CERT=
NCS_DATABASE_CONNECT_TIMEOUT=5
NCS_DATABASE_POOL_SIZE=4
NCS_DATABASE_MIGRATIONS=infrastructure/postgres/migrations
NCS_DATABASE_BACKUP_DIRECTORY=backups/postgresql
NCS_PG_DUMP=pg_dump
NCS_PG_RESTORE=pg_restore
NCS_LOG_LEVEL=info
NCS_LOG_DIRECTORY=runtime/development/logs

# Safe default is HTTPS. Set true in both processes only for development on
# numeric loopback 127.0.0.1 or ::1; non-development/non-loopback is rejected.
NCS_ALLOW_INSECURE_HTTP=false
NCS_TLS_CERTIFICATE=
NCS_TLS_PRIVATE_KEY=
NCS_CHARGE_TIME_SCALE=60
NCS_DASHBOARD_SNAPSHOT=runtime/development/dashboard-snapshot.json
NCS_CORS_ALLOWED_ORIGINS=

# Optional Tencent map credentials. TENCENT_MAP_JS_KEY is client-visible and is
# injected into the Vue web client at build time (restrict allowed origins in the
# Tencent console); TENCENT_MAP_SERVER_KEY is read only by ncs_server, which uses
# it for WebService geocoding, POI lookup and route planning. Never expose the
# Server Key to any browser.
TENCENT_MAP_JS_KEY=
TENCENT_MAP_SERVER_KEY=
TENCENT_MAP_JS_ORIGIN=http://localhost/

# Optional AI (Agent) provider settings, read only by ncs_server.
# AI_PROVIDER selects an OpenAI-compatible endpoint preset: openai, deepseek,
# qwen (DashScope compatible mode), claude (Anthropic compatible) or custom.
# For custom you MUST set AI_BASE_URL explicitly; otherwise the endpoint preset
# of AI_PROVIDER is used.
# AI_BASE_URL must be HTTPS; loopback HTTP is accepted for local development only.
# AI_API_KEY is never logged, echoed or returned in any API response, and must
# never be shipped to the web client. When AI_MODEL or AI_API_KEY is missing the
# Agent degrades to deterministic tool-only answers instead of failing.
AI_PROVIDER=openai
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=15000
