# NCS 迁移门禁（B-06）
#
# 一次性单元：应用顺序迁移（0001..0012）并核对已应用版本，然后退出。API 自己也会在启动时迁移，
# 但 Worker / Publisher 不迁移；让它们依赖本单元，比依赖"API 正好先启动过"更明确。
#
# 安装与启用：
#   systemctl enable ncs-migrate.service
#   systemctl start ncs-migrate.service      # 或 systemctl start ncs-api（见 After= 链）
[Unit]
Description=NCS schema migration gate
Documentation=file:/opt/ncs/docs/backend-architecture.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ncs
Group=ncs
EnvironmentFile=/etc/ncs/backend.env
ExecStart=/usr/local/bin/ncs-api -migrate-only
TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
